# Copy to application.properties and configure for your own environment.
# The real application.properties is excluded from Git.
jdbc.driverClassName = com.mysql.cj.jdbc.Driver
jdbc.url = jdbc:mysql://localhost:3306/scm
jdbc.username = scm_user
jdbc.password =
hibernate.dialect = org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto = update
hibernate.show_sql = true
hibernate.format_sql = true

hibernate.c3p0.min_size:5
hibernate.c3p0.max_size:20
hibernate.c3p0.timeout:300
hibernate.c3p0.max_statements:50
hibernate.c3p0.idle_test_period:3000
server.servlet.session.timeout=1m

PARAMETER:8002
TCP:5555
PATCH:5557
ATS_SERVER:127.0.0.1
OPERATING_SYSTEM:1337
FILE_PULL:5561
FILE_PUSH:5565
QR_Code_Path:/var/lib/scm/Barcode.png
