            <section class="content-header">
                <div class="row">
                    <div class="col-md-2"></div>
                    <div class="col-md-8">
                        <br><br>
                        <div class="card card-secondary">
                            <div class="card-header">Reset Password</div>
                            <div class="card-body">
                                <div class="row">

                                  <div class="col-md-3"></div>
                                            <div class="col-md-6">
                                                <label for="cname">User Name:</label>
                                                <input type="text" id="name1" readonly="true"  tabindex="1" class="form-control" data-toogle="tooltip" name="name1" value="<%=session.getAttribute("username")%>" >                                                                                                                  
                                            </div> 
                                            <div class="col-md-3"></div>

                                </div>
                                    <br>
                                        <div class="row">
                                            <div class="col-md-3"></div>
                                            <div class="col-md-6">
                                                <label for="cname">Old Password:</label>
                                                <input type="password" id="oldpass" placeholder="Enter Old Password" tabindex="2" class="form-control" data-toogle="tooltip" name="oldpass">                                                                                                                     
                                            </div> 
                                            <div class="col-md-3"></div>
                                        </div>
                                        <br>
                                        <div class="row">
                                            <div class="col-md-3"></div>
                                          <div class="col-md-6">
                                                <label for="pass">Password</label>&nbsp;&nbsp;&nbsp;<label id="label"></label>
                                                <input type="hidden" id="length">
                                                <input type="password" id="pass" tabindex="4"  class="form-control" minlength="8" maxlength="15" name="pass" onfocusout="checkPassstrength();" data-toogle="tooltip" placeholder="Enter Password">
                                                <span id="note" style="display:none; font-size: 12px" class="text-danger">Password length must be Min 8 characters & Max 15 characters. and  must contain at least one small & one capital alphabet & one special character and numeric digit.</span>
                                            </div> 
                                            <div class="col-md-3"></div>
                                        </div>
                                        <br>
                                        <div class="row">
                                            <div class="col-md-3"></div>
                                            <div class="col-md-6">
                                                <label for="Cpass">Confirm Password</label>
                                                <input type="hidden" id="passnotmatch">
                                                <input type="password" id="Cpass" tabindex="5"  maxlength="15" class="form-control" name="Cpass" data-toogle="tooltip" onfocusout="checkPass();" placeholder="Enter Confirm Password" onkeyup="checkPass999()">
                                                <span id="note1" style="display:none;"></span>
                                            </div>
                                            <div class="col-md-3"></div>
                                        </div>
                                        <br>
                                <div class="row">

                                    <div style="margin-top:15px;" class="col-md-12">
                                        <center>
                                            <input type="submit" tabindex="5" class="btn btn-primary m-t-10" id="View-btn" name="submit" value="Update">
                                                <input type="button" tabindex="6" class="btn btn-primary m-t-10" id="resetbtn" name="reset" value="Clear">
                                        </center>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2"></div>
                </div>
           
         </section>
